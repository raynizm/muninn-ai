# Copy to .env and adjust. Docker Compose reads it automatically.

# Database password. Change it; the database is not published outside the compose network.
POSTGRES_PASSWORD=change-me

# Host port the backend (API and web app) listens on. Put a TLS reverse proxy in front of it.
MUNINN_PORT=8080

# Largest accepted recording upload in bytes (default 200 MB).
MUNINN_MAX_UPLOAD_BYTES=209715200

# faster-whisper compute type: int8 is a good CPU default.
WHISPER_COMPUTE_TYPE=int8
