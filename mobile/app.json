{
  "expo": {
    "name": "Muninn",
    "slug": "muninn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "se.tcmt.muninn",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Muninn records audio when you press record, to transcribe and summarize it on your server.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "se.tcmt.muninn",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Muninn records audio when you press record, to transcribe and summarize it on your server."
        }
      ]
    ],
    "scheme": "muninn",
    "newArchEnabled": true
  }
}
